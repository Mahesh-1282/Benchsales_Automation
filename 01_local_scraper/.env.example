# ── JSearch API (Local Runner) ──────────────────────────────────────
# Get from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_jsearch_rapidapi_key_here

# ── NVIDIA NIM (Resume AI) ───────────────────────────────────────────
# Get from: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini API (Optional — better quality, free tier) ────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Databricks (for reference — used in notebooks, not here) ─────────
# Your Databricks workspace URL (e.g. https://adb-123456789.azuredatabricks.net)
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
# Personal Access Token (Settings → Developer → Access Tokens)
DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
