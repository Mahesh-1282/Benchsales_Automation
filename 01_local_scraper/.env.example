# ── JSearch API (Local Runner) ──────────────────────────────────────
# Get from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_rapidapi_key_here

# ── NVIDIA NIM (Resume AI + Job Enrichment) ──────────────────────────
# Get from: https://build.nvidia.com/  (free 1000 credits/month)
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Databricks ─────────────────────────────────────────────────────
# Your workspace URL (Settings → Workspace → URL)
DATABRICKS_HOST=https://adb-123456789.10.azuredatabricks.net

# Personal Access Token (Settings → Developer → Access Tokens → Generate new)
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SQL Warehouse ID — CRITICAL for saving data from the app!
# Databricks → Compute → SQL Warehouses → click your warehouse
# → Connection Details → HTTP Path = /sql/1.0/warehouses/YOUR_WAREHOUSE_ID
# Copy just the last part (after /warehouses/)
DATABRICKS_SQL_WAREHOUSE_ID=your_warehouse_id_here

# ── Admin ──────────────────────────────────────────────────────────
# Password to access the Admin Panel page
SYNTRA_ADMIN_PASSWORD=syntra_admin_2024

# ── Email Encryption (Optional) ────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=yAYnYvP6yaRHF_4V3PGqvPK_Rg8e23MO2FY0WOuc3aI

# ── Gemini API (Optional — alternative AI provider) ────────────────
GEMINI_API_KEY=
